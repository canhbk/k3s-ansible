[Unit]
Description=GitHub Actions Runner ({{ service_org_name }} - {{ service_runner_name }})
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
ExecStartPre=-/usr/bin/docker system prune -f --filter "until=24h"
ExecStart={{ service_runner_dir }}/runsvc.sh
User={{ runner_user }}
WorkingDirectory={{ service_runner_dir }}
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5min
Restart=always
RestartSec=30

# Force restart every 6 hours to clear zombie listeners
RuntimeMaxSec=21600

# Resource limits
MemoryMax=6G
MemoryHigh=4G

Environment="RUNNER_ALLOW_RUNASROOT=1"
Environment="DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1"

NoNewPrivileges=false
ProtectSystem=false
PrivateTmp=false

[Install]
WantedBy=multi-user.target
